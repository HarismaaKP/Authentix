"""
Blockchain layer for Authentix.

Primary path:
    Connect to an Ethereum node using Web3.py and call the
    deployed AuthChain smart contract.

Fallback path:
    Use a local SHA-256 hash-linked ledger.

Vercel:
    The fallback ledger is stored in /tmp.
    This is temporary storage and is NOT permanent on Vercel.

For a permanent blockchain deployment, configure a hosted RPC
and a proper transaction signer/private key.
"""

import os
import json
import hashlib
import threading
from datetime import datetime, timezone


# ---------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------

BASE_DIR = os.path.dirname(
    os.path.abspath(__file__)
)

if os.environ.get("VERCEL"):
    DATA_DIR = os.path.join(
        "/tmp",
        "authentix_blockchain"
    )
else:
    DATA_DIR = os.path.join(
        BASE_DIR,
        "data"
    )

os.makedirs(
    DATA_DIR,
    exist_ok=True
)

CHAIN_FILE = os.path.join(
    DATA_DIR,
    "chain.json"
)

RPC_URL = os.environ.get(
    "RPC_URL",
    "http://127.0.0.1:8545"
)

CONTRACT_ADDRESS = os.environ.get(
    "CONTRACT_ADDRESS"
)

_lock = threading.Lock()


# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------

def _now():
    return datetime.now(
        timezone.utc
    ).isoformat()


def _hash_block(
    index,
    product_id,
    image_hash,
    prev_hash,
    timestamp
):
    payload = (
        f"{index}"
        f"{product_id}"
        f"{image_hash}"
        f"{prev_hash}"
        f"{timestamp}"
    ).encode("utf-8")

    return hashlib.sha256(
        payload
    ).hexdigest()


# ---------------------------------------------------------------------
# Local Ledger
# ---------------------------------------------------------------------

class LocalLedger:

    def __init__(self):

        if not os.path.exists(
            CHAIN_FILE
        ):
            self._create_genesis()


    def _create_genesis(self):

        genesis = {
            "index": 0,
            "product_id": "GENESIS",
            "image_hash": "0" * 64,
            "prev_hash": "0" * 64,
            "timestamp": _now(),
        }

        genesis["hash"] = _hash_block(
            genesis["index"],
            genesis["product_id"],
            genesis["image_hash"],
            genesis["prev_hash"],
            genesis["timestamp"]
        )

        self._write([
            genesis
        ])


    def _read(self):

        try:

            with open(
                CHAIN_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                data = json.load(f)

                if isinstance(data, list):
                    return data

        except Exception:
            pass

        return []


    def _write(self, chain_data):

        with open(
            CHAIN_FILE,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                chain_data,
                f,
                indent=2
            )


    def add_block(
        self,
        product_id,
        image_hash
    ):

        with _lock:

            chain_data = self._read()

            if not chain_data:

                self._create_genesis()

                chain_data = self._read()

            previous = chain_data[-1]

            index = (
                previous["index"] + 1
            )

            timestamp = _now()

            block = {
                "index": index,
                "product_id": product_id,
                "image_hash": image_hash,
                "prev_hash": previous["hash"],
                "timestamp": timestamp,
            }

            block["hash"] = _hash_block(
                index,
                product_id,
                image_hash,
                previous["hash"],
                timestamp
            )

            chain_data.append(
                block
            )

            self._write(
                chain_data
            )

            # Simulated transaction hash for local fallback.
            tx_hash = (
                "0xLOCAL"
                + block["hash"][:58]
            )

            return (
                index,
                tx_hash
            )


    def get_block(
        self,
        product_id
    ):

        chain_data = self._read()

        for block in reversed(
            chain_data
        ):

            if (
                block.get("product_id")
                == product_id
            ):
                return block

        return None


    def verify_chain_integrity(self):

        chain_data = self._read()

        if not chain_data:
            return True

        # Check genesis.
        genesis = chain_data[0]

        if genesis.get(
            "product_id"
        ) != "GENESIS":
            return False

        for i in range(
            1,
            len(chain_data)
        ):

            block = chain_data[i]

            expected_hash = _hash_block(
                block["index"],
                block["product_id"],
                block["image_hash"],
                block["prev_hash"],
                block["timestamp"]
            )

            if (
                expected_hash
                != block.get("hash")
            ):
                return False

            if (
                block.get("prev_hash")
                != chain_data[i - 1].get("hash")
            ):
                return False

        return True


# ---------------------------------------------------------------------
# Blockchain Client
# ---------------------------------------------------------------------

class BlockchainClient:

    def __init__(self):

        self.mode = "local_ledger"

        self.ledger = LocalLedger()

        self.w3 = None
        self.contract = None

        self._try_web3()


    # -----------------------------------------------------------------
    # Web3 connection
    # -----------------------------------------------------------------

    def _try_web3(self):

        # If there is no contract address, simply use fallback.
        if not CONTRACT_ADDRESS:
            print(
                "CONTRACT_ADDRESS not configured. "
                "Using local ledger."
            )
            return

        try:

            from web3 import Web3

            w3 = Web3(
                Web3.HTTPProvider(
                    RPC_URL,
                    request_kwargs={
                        "timeout": 3
                    }
                )
            )

            if not w3.is_connected():

                print(
                    "Blockchain RPC not connected. "
                    "Using local ledger."
                )
                return

            abi_path = os.path.join(
                BASE_DIR,
                "blockchain",
                "AuthChainABI.json"
            )

            if not os.path.exists(
                abi_path
            ):

                print(
                    "AuthChainABI.json not found. "
                    "Using local ledger."
                )
                return

            with open(
                abi_path,
                "r",
                encoding="utf-8"
            ) as f:

                abi = json.load(f)

            checksum_address = (
                Web3.to_checksum_address(
                    CONTRACT_ADDRESS
                )
            )

            self.w3 = w3

            self.contract = (
                w3.eth.contract(
                    address=checksum_address,
                    abi=abi
                )
            )

            self.mode = "web3"

            print(
                "Blockchain connected successfully."
            )

        except Exception as e:

            print(
                "Web3 connection unavailable:",
                str(e)
            )

            self.mode = "local_ledger"


    # -----------------------------------------------------------------
    # Register product
    # -----------------------------------------------------------------

    def register_product(
        self,
        product_id,
        image_hash
    ):

        if (
            self.mode == "web3"
            and self.contract
        ):

            try:

                accounts = (
                    self.w3.eth.accounts
                )

                if accounts:

                    account = accounts[0]

                    transaction = (
                        self.contract
                        .functions
                        .registerProduct(
                            product_id,
                            image_hash
                        )
                        .transact({
                            "from": account
                        })
                    )

                    receipt = (
                        self.w3.eth
                        .wait_for_transaction_receipt(
                            transaction
                        )
                    )

                    return (
                        receipt.blockNumber,
                        receipt.transactionHash.hex()
                    )

                print(
                    "No unlocked blockchain account "
                    "available. Using local ledger."
                )

            except Exception as e:

                print(
                    "Web3 registration failed:",
                    str(e)
                )


        return self.ledger.add_block(
            product_id,
            image_hash
        )


    # -----------------------------------------------------------------
    # Get product record
    # -----------------------------------------------------------------

    def get_record(
        self,
        product_id
    ):

        if (
            self.mode == "web3"
            and self.contract
        ):

            try:

                result = (
                    self.contract
                    .functions
                    .getProduct(
                        product_id
                    )
                    .call()
                )

                return {
                    "product_id": product_id,
                    "image_hash": result[0],
                    "block_index": None,
                }

            except Exception as e:

                print(
                    "Web3 get record failed:",
                    str(e)
                )


        return self.ledger.get_block(
            product_id
        )


    # -----------------------------------------------------------------
    # Chain status
    # -----------------------------------------------------------------

    def chain_status(self):

        try:

            chain_data = (
                self.ledger._read()
            )

            return {
                "mode": self.mode,
                "integrity_ok":
                    self.ledger.verify_chain_integrity(),
                "blocks":
                    len(chain_data),
            }

        except Exception:

            return {
                "mode": self.mode,
                "integrity_ok": False,
                "blocks": 0,
            }


# ---------------------------------------------------------------------
# Global blockchain client
# ---------------------------------------------------------------------

chain = BlockchainClient()